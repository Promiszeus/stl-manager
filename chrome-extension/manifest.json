{
  "manifest_version": 3,
  "name": "STL-Manager Tracker",
  "version": "1.3.0",
  "description": "Erfasst die exakte Modell-URL beim Download (MakerWorld, Printables, Cults3D, Thingiverse etc.) und füllt gespeicherte Zugangsdaten automatisch aus.",
  "permissions": [
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.makerworld.com/*",
        "*://*.bambulab.com/*",
        "*://*.printables.com/*",
        "*://*.cults3d.com/*",
        "*://*.thingiverse.com/*",
        "*://*.crealitycloud.com/*",
        "*://*.makeronline.com/*"
      ],
      "js": ["autofill.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
